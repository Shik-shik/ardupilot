# SkyPulse F4 V3: board-only bench port from authenticated Betaflight mapping.
# No aircraft tune, payload controller, custom EKF, or OCCAM profile.
MCU STM32F4xx STM32F405xx
APJ_BOARD_ID AP_HW_SKYPULSEF4V3_LOCAL
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 48
define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 1
STM32_ST_USE_TIMER 5

SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PA9 USART1_TX USART1
PA10 USART1_RX USART1
PA2 USART2_TX USART2
PA3 USART2_RX USART2
PC10 USART3_TX USART3
PC11 USART3_RX USART3
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA
PC12 UART5_TX UART5 NODMA
PD2 UART5_RX UART5 NODMA

I2C_ORDER I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
BARO DPS310 I2C:0:0x76
BARO DPS310 I2C:0:0x77

PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3
PB12 GYRO1_CS CS
PC4 GYRO1_INT INPUT
SPIDEV imu1 SPI3 DEVID1 GYRO1_CS MODE3 2*MHZ 8*MHZ
# Betaflight gyro_1_sensor_align=CW90; manual axis check still required.
IMU LSM6DSV SPI:imu1 ROTATION_YAW_90

PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PA4 FLASH1_CS CS
PC3 OSD1_CS CS
SPIDEV osd SPI2 DEVID1 OSD1_CS MODE0 10*MHZ 10*MHZ
define OSD_ENABLED 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin
# The external flash JEDEC 0x852018 is recorded, but logging is not enabled
# without checking the upstream driver's support for this part.

# Physical output order from Betaflight; no vehicle functions assigned here.
PC7 TIM8_CH2 TIM8 PWM(1) GPIO(50)
PC8 TIM8_CH3 TIM8 PWM(2) GPIO(51)
PC9 TIM8_CH4 TIM8 PWM(3) GPIO(52)
PC6 TIM8_CH1 TIM8 PWM(4) GPIO(53)
PB10 TIM2_CH3 TIM2 PWM(5) GPIO(54)
PB11 TIM2_CH4 TIM2 PWM(6) GPIO(55)
PB0 TIM3_CH3 TIM3 PWM(7) GPIO(56)
PB1 TIM3_CH4 TIM3 PWM(8) GPIO(57)
PA6 TIM13_CH1 TIM13 PWM(9) GPIO(58) NODMA
PA7 TIM14_CH1 TIM14 PWM(10) GPIO(59) NODMA
PB9 TIM11_CH1 TIM11 PWM(11) GPIO(60) NODMA
DMA_PRIORITY SPI3* TIM8* TIM2*

PC2 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
PC0 RSSI_ADC ADC1
# ADC wiring only: battery monitor/scaling require independent validation.

# Unknown vendor PINIO/power controls remain inputs, with no relay mapping.
PA5 UNUSED_CONTROL1 INPUT
PC13 UNUSED_CONTROL2 INPUT
PC5 UNUSED_CONTROL3 INPUT
PB2 UNUSED_CONTROL4 INPUT
PA15 UNUSED_CAMERA_CONTROL INPUT
PB8 UNUSED_BEEPER INPUT
PC14 UNUSED_LED1 INPUT
PC15 UNUSED_LED2 INPUT
